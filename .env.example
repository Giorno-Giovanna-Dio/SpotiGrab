# 綠界 ECPay 金流設定
# 測試環境的測試商店編號和金鑰（可直接使用）
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs

# API 端點（測試環境）
ECPAY_API_URL=https://payment-stage.ecpay.com.tw/Cashier/AioCheckOut/V5

# 付款完成後的回調網址（需要對外可存取的網址）
# 本地開發可使用 ngrok 或其他內網穿透工具
# 格式：https://your-domain.com/api/payment/callback
ECPAY_RETURN_URL=

# 付款後返回的前端網址
# 格式：https://your-domain.com/payment/success
ECPAY_CLIENT_BACK_URL=

# 應用程式基礎 URL（用於生成完整的回調網址）
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 正式環境設定（申請特約商戶後使用）
# ECPAY_MERCHANT_ID=your_merchant_id
# ECPAY_HASH_KEY=your_hash_key
# ECPAY_HASH_IV=your_hash_iv
# ECPAY_API_URL=https://payment.ecpay.com.tw/Cashier/AioCheckOut/V5
