# Spotify Developer Dashboard: https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# 下載工具路徑（選填，預設自動搜尋 PATH 與常見安裝位置）
# YT_DLP_PATH=/usr/local/bin/yt-dlp
# FFMPEG_PATH=/usr/local/bin/ffmpeg

# YouTube 403 修復（強烈建議 Mac 使用者設定）
# 從瀏覽器讀取 YouTube 登入 cookies，避免 HTTP 403
# Mac: safari 或 chrome · Windows: chrome 或 edge
YT_DLP_COOKIES_FROM_BROWSER=safari

# 或使用 cookies 檔案（從瀏覽器匯出）
# YT_DLP_COOKIES_FILE=/path/to/youtube_cookies.txt

# 進階：自訂 YouTube player client
# YT_DLP_PLAYER_CLIENT=default,-tv_simply
